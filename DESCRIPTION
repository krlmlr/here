Package: here
Title: A Simpler Way to Find Your Files
Version: 1.0.2.9024
Date: 2026-10-11
Authors@R: c(
    person("Kirill", "Müller", , "kirill@cynkra.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-1416-3412")),
    person("Jennifer", "Bryan", , "jenny@posit.co", role = "ctb",
           comment = c(ORCID = "0000-0002-6983-2759"))
